rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth == null || (request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'District Admin', 'Block Admin']));
      // Allow unauthenticated users to query the users collection by mobile number
      allow list: if request.auth == null;
    }

    // Allow public read access to these collections
    match /assets/{assetId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /finance/{financeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /osr/{osrId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /model/{modelId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /kyp/{kypId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /model_answers/{answerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow citizens and admins to access the counters for ID generation
    match /counters/{counterId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Citizen', 'Panchayat Admin', 'Block Admin', 'District Admin', 'Super Admin'];
    }

    // Allow citizens to create grievances, and admins to manage them
    match /grievances/{grievanceId} {
      allow list: if request.auth == null;
      allow read: if request.auth != null && 
        (
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Citizen' && resource.data.userId == request.auth.uid) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Panchayat Admin' && resource.data.block == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.block && resource.data.panchayat == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.panchayat) ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'District Admin', 'Block Admin'])
        );
      allow create: if request.auth != null && ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Citizen' && request.resource.data.userId == request.auth.uid) || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Panchayat Admin', 'Block Admin', 'District Admin', 'Super Admin']));
      allow update: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Panchayat Admin', 'Block Admin', 'District Admin', 'Super Admin'];
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin';
    }
  }
}
